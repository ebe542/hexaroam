  (text "Three keyed 2x6 signal ports. Short cables. No motor power on signal connectors."
    (exclude_from_sim no)
    (at 19.05 27.94 0)
    (effects
      (font
        (size 1.5 1.5))
      (justify left bottom))
    (uuid "12b1a0b8-db89-44a8-bf54-ed31feca326e"))
  (text "Present firmware uses TX only. Adapter in 3.3V TTL mode."
    (exclude_from_sim no)
    (at 204.47 158.75 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "25192a0e-ff69-42f5-9424-c0594838d944"))
  (text "The hierarchical links model external cables. These are separate physical assemblies."
    (exclude_from_sim no)
    (at 19.05 259.08 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "2fd32652-426e-4cef-b3b3-fe9572186b0f"))
  (text "1 TX -> adapter RX; 2 RX <- adapter TX; 3 GND."
    (exclude_from_sim no)
    (at 204.47 153.67 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "30ac2c8d-fed3-4f6f-9485-65a30fdd6615"))
  (text "Replicate the module for Ports B/C after current, wiring and clamp sizing are verified."
    (exclude_from_sim no)
    (at 19.05 254 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "3bb72192-10c4-4c33-9d7e-da96ac853c8c"))
  (text "Odd pins 1/3/5/7/9/11 = S0/S1/S2/S3/S4/S5; all even pins = GND."
    (exclude_from_sim no)
    (at 204.47 99.06 0)
    (effects
