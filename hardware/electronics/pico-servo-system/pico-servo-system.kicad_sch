        (size 1.27 1.27))
      (justify left bottom))
    (uuid "55683cde-0e64-4778-a682-039d6888ce44"))
  (text "Use two 1x20 female sockets. Pico USB connector at board edge."
    (exclude_from_sim no)
    (at 19.05 210.82 0)
    (effects
